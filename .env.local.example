# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (Settings > API > service_role) - KEEP SECRET, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin password. Use a long, unique password and keep it out of source control.
ADMIN_PASSWORD=change-this-to-a-long-random-password

# Separate random secret used to sign admin sessions. Generate at least 32 random characters.
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
